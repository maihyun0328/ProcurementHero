  id: f2
  title: "\uD3ED\uC5FC\uBCF4\uB2E4 \uBA3C\uC800 \uC900\uBE44\uD558\uB294 \uBCF4\uAC74\uC18C"
  placeName: "\uC0C8\uBD04\uC2DC \uBCF4\uAC74\uC18C"
  intro: "\uC544\uC9C1 \uD55C\uC0B0\uD560 \uB54C \uB354\uC704\uC640 \uBB3C \uBD80\uC871\uC774
    \uC62C \uACF3\uC744 \uD655\uC778\uD558\uACE0 \uC7A5\uCE58\uB97C \uB193\uC744
    \uC790\uB9AC\uB97C \uC815\uD574\uC694."
  arrivalLine: "\uC544\uC9C1\uC740 \uD55C\uC0B0\uD558\uB124. \uC624\uD6C4 \uB354\uC704
    \uC804\uC5D0 \uB458\uB7EC\uBCF4\uC790."
  theme: 1
  forecast: "14:00 \uD3ED\uC5FC \xB7 \uBCF4\uAC74\uC18C \uB300\uAE30 \uC778\uC6D0
    \uC99D\uAC00 \uC608\uC0C1"
  nowTime: 11:00
  eventTime: 14:00
  eventCaption: "\uD3ED\uC5FC \uACBD\uBCF4, \uBCF4\uAC74\uC18C \uB300\uAE30 \uC778\uC6D0\uC774
    \uB298\uC5B4\uC694"
  responseCaption: "\uC628\uB3C4 \uC13C\uC11C\uAC00 \uB354\uC704\uB97C \uAC10\uC9C0\uD588\uC5B4\uC694"
  budget: 85
  draftNumbers: 1
  playerStart: {x: 0, y: -7}
  problems:
  - id: H
    displayName: "\uB300\uAE30\uC2E4"
