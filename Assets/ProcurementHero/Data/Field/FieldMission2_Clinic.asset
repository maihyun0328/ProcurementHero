    zoneCenter: {x: -4.2, y: 3.6}
    zoneSize: {x: 11.4, y: 6.4}
    residentPosition: {x: -6.4, y: 4.8}
    line: "\uBC8C\uC368 \uBD80\uCC44\uC9C8\uC774 \uB098\uC624\uB124\uC694. \uC624\uD6C4\uC5D4
      \uB354 \uB365\uACA0\uC8E0?"
    eventLine: "\uB300\uAE30\uC2E4\uC774 \uB108\uBB34 \uB354\uC6CC\uC694"
    solvedLine: "\uC774\uC81C \uB300\uAE30\uC2E4\uC774 \uC2DC\uC6D0\uD574\uC84C\uC5B4\uC694"
    earlyLevel: 0.3
    memo: "\uC2E4\uB0B4\uB9CC \uC2DD\uD790 \uB54C\uB294 \uC791\uC740 \uC7A5\uCE58\uB85C\uB3C4
      \uCDA9\uBD84."
  - id: W
    displayName: "\uBCF5\uB3C4 \uC27C\uD130"
    kind: 2
    required: 1
    mustObserve: 1
    observePoint: {x: 6, y: 4.2}
    zoneCenter: {x: 6, y: 4.4}
    zoneSize: {x: 7.4, y: 5}
    residentPosition: {x: 6.4, y: 5.2}
    line: "\uBB3C\uD1B5\uC774 \uBC8C\uC368 \uBE44\uC5C8\uC5B4\uC694. \uC0AC\uB78C\uC774
      \uB298\uBA74 \uC5B4\uCA4C\uC8E0?"
    eventLine: "\uBB3C\uD1B5\uC774 \uBE44\uC5B4\uC11C \uB9C8\uC2E4 \uBB3C\uC774 \uC5C6\uC5B4\uC694"
    solvedLine: "\uC774\uC81C \uBAA9\uB9C8\uB97C \uB54C \uBB3C\uC744 \uB9C8\uC2E4
